# MeshSettle environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# --- Postgres ---
POSTGRES_USER=meshsettle
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=meshsettle
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (dedupe store) ---
REDIS_URL=redis://localhost:6379/0
# TTL in seconds for an idempotency claim key
DEDUPE_TTL_SECONDS=86400

# --- RabbitMQ ---
RABBITMQ_USER=meshsettle
RABBITMQ_PASSWORD=replace-me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
SETTLEMENT_QUEUE=meshsettle.settlements

# --- Crypto keys (PEM, newlines escaped as \n) ---
# Generate with: python -m shared.keygen
# Ed25519 signing keypair, held by the sender device
SENDER_SIGNING_PRIVATE_KEY_PEM=
SENDER_SIGNING_PUBLIC_KEY_PEM=
# RSA keypair, held by the settlement service for AES key unwrapping
SETTLEMENT_RSA_PRIVATE_KEY_PEM=
SETTLEMENT_RSA_PUBLIC_KEY_PEM=

# --- Mesh simulation ---
# Hops a packet makes before a connected node bridges it to the queue
MESH_HOP_COUNT=2
# Hard ceiling on recorded hops, for relay-loop protection
MESH_HOP_LIMIT=16
# Identity of this relay node, recorded in each hop record
MESH_NODE_ID=relay-1
MESH_RELAY_URL=http://localhost:8002
BRIDGE_URL=http://localhost:8003
MESH_FORWARD_TIMEOUT_SECONDS=5.0

# --- Rate limiting (public-facing endpoints) ---
RATE_LIMIT_PER_MINUTE=60

# --- Logging ---
LOG_LEVEL=INFO
