# MeshSettle environment configuration — reference for every supported variable.
#
# Do not hand-copy this file. Run:
#
#     python scripts/bootstrap_env.py
#
# which generates `.env` (all of the below, with freshly generated keys) and
# `.env.infra` (only the credentials the Postgres and RabbitMQ images need)
# with matching passwords, so the two cannot drift. Both are gitignored.
#
# NEVER commit .env or .env.infra.

# --- Postgres ---
POSTGRES_USER=meshsettle
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=meshsettle
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (dedupe store) ---
REDIS_URL=redis://localhost:6379/0
# How long a "already settled" marker is remembered. Sets the window in which
# a redelivered duplicate is rejected by Redis without touching Postgres.
DEDUPE_TTL_SECONDS=86400
# How long an in-flight claim is held before it is considered abandoned. Short
# on purpose: if a consumer dies mid-settlement, the claim must expire so the
# broker's redelivery can win it and finish the job.
DEDUPE_CLAIM_TTL_SECONDS=60

# --- RabbitMQ ---
RABBITMQ_USER=meshsettle
RABBITMQ_PASSWORD=replace-me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
SETTLEMENT_QUEUE=meshsettle.settlements

# --- Crypto keys (PEM, newlines escaped as \n) ---
# Generate with: python -m shared.keygen
# Ed25519 signing keypair, held by the sender device
SENDER_SIGNING_PRIVATE_KEY_PEM=
SENDER_SIGNING_PUBLIC_KEY_PEM=
# RSA keypair, held by the settlement service for AES key unwrapping
SETTLEMENT_RSA_PRIVATE_KEY_PEM=
SETTLEMENT_RSA_PUBLIC_KEY_PEM=

# --- Mesh simulation ---
# Hops a packet makes before a connected node bridges it to the queue
MESH_HOP_COUNT=2
# Hard ceiling on recorded hops, for relay-loop protection
MESH_HOP_LIMIT=16
# Identity of this relay node, recorded in each hop record
MESH_NODE_ID=relay-1
MESH_RELAY_URL=http://localhost:8002
BRIDGE_URL=http://localhost:8003
MESH_FORWARD_TIMEOUT_SECONDS=5.0

# --- Rate limiting (public-facing endpoints) ---
RATE_LIMIT_PER_MINUTE=60

# --- Logging ---
LOG_LEVEL=INFO
